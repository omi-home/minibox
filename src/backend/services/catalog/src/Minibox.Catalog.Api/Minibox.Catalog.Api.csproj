<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Nhúng database/schemas/catalog/scripts/**/*.sql cho chế độ migrate (Directory.Build.props, spec §4.4). -->
    <MiniboxService>catalog</MiniboxService>
    <!-- Chỉ khi build template tại chỗ: script nằm trong templates/minibox-service/database/catalog/ (dotnet new chép ra database/schemas/<svc>/). -->
    <MiniboxScripts Condition="Exists('$(MSBuildProjectDirectory)/../../database/catalog/scripts')">$(MSBuildProjectDirectory)/../../database/catalog/scripts</MiniboxScripts>
  </PropertyGroup>
  <ItemGroup>
    <!-- Mediator sinh mã đăng ký handler/pipeline tại composition root (spec §5.4). -->
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <!-- Wolverine Development sinh code lúc chạy (cần Roslyn); Release/production nạp code sinh sẵn (TypeLoadMode.Static, MessagingSetup). -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Minibox.Catalog.Application/Minibox.Catalog.Application.csproj" />
    <ProjectReference Include="../Minibox.Catalog.Infrastructure/Minibox.Catalog.Infrastructure.csproj" />
    <ProjectReference Include="../../../../building-blocks/src/Minibox.BuildingBlocks.Web/Minibox.BuildingBlocks.Web.csproj" />
  </ItemGroup>
</Project>
