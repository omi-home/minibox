{
  "$schema": "http://json.schemastore.org/template",
  "author": "minibox",
  "classifications": ["Minibox", "Service"],
  "identity": "Minibox.Templates.Service",
  "name": "Minibox service",
  "shortName": "minibox-service",
  "description": "Khung service Clean Architecture (spec §5.1). Chạy trong src/backend: dotnet new minibox-service -n Order -o services/order",
  "tags": { "language": "C#", "type": "project" },
  "sourceName": "ServiceName",
  "preferNameDirectory": true,
  "symbols": {
    "svc": { "type": "derived", "valueSource": "name", "valueTransform": "lower", "replaces": "servicename" }
  },
  "forms": { "lower": { "identifier": "lowerCaseInvariant" } }
}
