{
  "$schema": "http://json.schemastore.org/template",
  "author": "minibox",
  "classifications": [
    "Minibox",
    "Service"
  ],
  "identity": "Minibox.Templates.Service",
  "name": "Minibox service",
  "shortName": "minibox-service",
  "description": "Khung service Clean Architecture (spec §5.1–§5.4: Endpoints → Mediator pipeline → Features, Wolverine outbox) + database/schemas/<svc>/ kiểu SSDT (spec §4.4). Chạy trong src/backend: dotnet new minibox-service -n Order -o services/order",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "ServiceName",
  "preferNameDirectory": true,
  "symbols": {
    "svc": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "lower",
      "replaces": "servicename",
      "fileRename": "servicename"
    }
  },
  "forms": {
    "lower": {
      "identifier": "lowerCaseInvariant"
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**",
        "**/*.user",
        "database/**"
      ]
    },
    {
      "source": "database/",
      "target": "../../../../database/schemas/"
    }
  ]
}
