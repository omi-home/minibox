<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- XML doc bắt buộc cho API public (spec §8.7): thiếu → CS1591, sai param/cref → CS1572/CS1573/CS1574; thành lỗi nhờ TreatWarningsAsErrors. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('Tests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- Service đặt <MiniboxService>order</MiniboxService> ở project Api → nhúng database/services/<svc>/migrations/*.sql
       với LogicalName migrations/<file>.sql cho DbMigrator (spec §4.4). Item được đánh giá sau property nên đọc được giá trị của csproj. -->
  <ItemGroup Condition="'$(MiniboxService)' != ''">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../database/services/$(MiniboxService)/migrations/*.sql"
                      LogicalName="migrations/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
