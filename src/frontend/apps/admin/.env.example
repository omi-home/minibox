# BFF admin (spec §3.2). Sao chép thành .env.local khi chạy dev.
# Khóa AES-256-GCM mã hóa cookie phiên: base64 của 32 byte (node -e "console.log(crypto.randomBytes(32).toString('base64'))").
ADMIN_SESSION_KEY=
# URL nội bộ của service identity.
IDENTITY_URL=http://localhost:5001
# URL nội bộ của service localization (chuỗi giao diện, danh sách locale).
LOCALIZATION_URL=http://localhost:5002
# Origin công khai của app admin (kiểm Origin chống CSRF); bỏ trống thì dùng origin của request.
ADMIN_ORIGIN=http://localhost:3001
