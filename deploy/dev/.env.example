# Chép thành deploy/dev/.env để ghi đè giá trị mặc định khi dev (.env bị .gitignore; scripts/dev.mjs tự nạp).
# staging/production KHÔNG dùng file này: secret nằm ở /srv/minibox/<env>/secrets/ (spec §8.4).

POSTGRES_PASSWORD=minibox
RABBITMQ_USER=minibox
RABBITMQ_PASSWORD=minibox

# Cổng mở trên 127.0.0.1 (đổi nếu trùng dịch vụ khác trên máy)
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
SEAWEEDFS_S3_PORT=8333
CLAMAV_PORT=3310
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
