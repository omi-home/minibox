# staging không dùng .env cho secret. Tạo các file sau trong /srv/minibox/staging/secrets/ (chủ root, thư mục 700, file 600):
#   postgres_admin.password   mật khẩu db_admin (một dòng)
#   rabbitmq.conf             default_user = minibox
#                             default_pass = <mật khẩu>
#   seaweedfs_s3.json         cấu hình -s3.config của SeaweedFS (identities + access key)
#   <svc>_app.password, <svc>_migrator.password   do node database/bootstrap/run.mjs staging sinh
#   Sinh tự động mỗi lần deploy (scripts/deploy.mjs, chủ = uid user trong image, quyền 400 — không sửa tay):
#     <svc>_app.connection, backend_rabbitmq.uri, frontend_rabbitmq.url
#   Sinh một lần nếu chưa có rồi giữ nguyên (sao lưu cùng secrets/; mất identity_mfa.key = phải đăng ký lại MFA):
#     identity_mfa.key, admin_session.key
#
# Biến không bí mật cho service app (deploy/apps.yaml), đặt trong deploy/staging/.env:
# ADMIN_ORIGIN=https://admin.example.com
# SHOP_PUBLIC_URL=https://shop.example.com
