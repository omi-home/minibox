# Lịch pgBackRest trên homeserver (spec §8.6): full Chủ nhật, diff các ngày còn lại; expire tự chạy sau mỗi backup.
# Cài: sudo install -o root -g root -m 644 deploy/backup/pgbackrest.cron /etc/cron.d/minibox-pgbackrest (cron bỏ qua file ghi được bởi group/other).
# Cluster khởi tạo trước khi có image này: chạy một lần
#   docker exec -u postgres minibox-<env>-database-postgres pgbackrest --stanza=minibox stanza-create
# m h dom mon dow user command
30 2 * * 0   root docker exec -u postgres minibox-production-database-postgres pgbackrest --stanza=minibox --type=full backup
30 2 * * 1-6 root docker exec -u postgres minibox-production-database-postgres pgbackrest --stanza=minibox --type=diff backup
0 3 * * 0    root docker exec -u postgres minibox-staging-database-postgres pgbackrest --stanza=minibox --type=full backup
0 3 * * 1-6  root docker exec -u postgres minibox-staging-database-postgres pgbackrest --stanza=minibox --type=diff backup
# Restore thử + PITR staging sau bản full (scripts/restore-test.mjs, kết quả là metric minibox.backup.* trong Prometheus).
# MINIBOX_REPO = thư mục checkout repo trên homeserver (cùng chỗ deploy/deploy.sh chạy) — sửa khi cài nếu khác.
# Cron chạy root với MINIBOX_REPO → checkout repo phải thuộc root, user khác không ghi được.
MINIBOX_REPO=/srv/minibox/repo
# PATH mặc định của cron có thể không có node (cài vào /usr/local/bin).
PATH=/usr/local/bin:/usr/bin:/bin
0 5 * * 0    root node "$MINIBOX_REPO/scripts/restore-test.mjs" staging
