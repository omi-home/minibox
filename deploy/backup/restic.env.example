# Mẫu /srv/minibox/backup/restic.env (spec §8.6, D16) — cấu hình restic cho scripts/restic-backup.mjs; giá trị thật không vào repo.
# Cạnh nó: /srv/minibox/backup/restic.password (một dòng, ngẫu nhiên ≥ 32 ký tự: openssl rand -base64 48), cả thư mục root chmod 700.
#
# Đích (OPEN-03 chưa chốt → repo cục bộ, CHƯA đạt DR mở bán). Đổi đích = sửa dòng này; lần chạy sau tự `restic init` repo mới.
RESTIC_REPOSITORY=/config/repo
# Khi chốt OPEN-03, ví dụ S3 bất kỳ:
# RESTIC_REPOSITORY=s3:https://s3.example.com/minibox-backup
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
